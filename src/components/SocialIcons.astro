---
/**
 * Überschreibt die Social-Symbole der Kopfzeile. Von links nach rechts:
 * „build: <Blockhöhe>", Spenden-Symbol (öffnet ein Fenster mit Lightning-Adresse und QR-Code), GitHub.
 * Die Blockhöhe schreibt `scripts/stamp-build.mjs` bei jedem Build nach `src/config/build.json`.
 * Der QR-Code entsteht beim Build (Paket `qrcode`) und steht als SVG in der Seite.
 */
import Default from '@astrojs/starlight/components/SocialIcons.astro';
import QRCode from 'qrcode';
import build from '../config/build.json';

const ADDRESS = 'phalnx@21mio.space';
const when = build.date ? new Date(build.date).toLocaleString('de-DE', { timeZone: 'UTC' }) + ' UTC' : '';
const qr = await QRCode.toString(ADDRESS, {
	type: 'svg',
	margin: 1,
	errorCorrectionLevel: 'M',
	color: { dark: '#000000', light: '#ffffff' },
});
---

<span class="phalnx-build" title={`Bitcoin-Blockhöhe beim Erstellen dieser Seite${when ? ` (${when})` : ''}`}>
	build: {build.block}
</span>
<button type="button" class="phalnx-donate-btn" aria-haspopup="dialog" title="Sats spenden">
	<span class="sr-only">Spenden</span>
	<svg
		aria-hidden="true"
		width="20"
		height="20"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
	>
		<path d="M11 14h2a2 2 0 1 0 0-4h-3c-.6 0-1.1.2-1.4.6L3 16"></path>
		<path d="m7 20 1.6-1.4c.3-.4.8-.6 1.4-.6h4c1.1 0 2.1-.4 2.8-1.2l4.6-4.4a2 2 0 0 0-2.75-2.91l-4.2 3.9"></path>
		<path d="m2 15 6 6"></path>
		<path d="M19.5 8.5c.7-.7 1.5-1.6 1.5-2.7A2.73 2.73 0 0 0 16 4a2.78 2.78 0 0 0-5 1.8c0 1.2.8 2 1.5 2.8L16 12Z"></path>
	</svg>
</button>
<Default {...Astro.props} />

<template class="phalnx-donate-tpl">
	<div class="phalnx-donate-head">
		<img src="/favicon.png" alt="" width="48" height="48" />
		<p><strong>Gefällt dir die Anleitung?</strong><br />Dann freuen wir uns über ein paar Sats.</p>
	</div>
	<a
		class="phalnx-donate-qr"
		href={`lightning:${ADDRESS}`}
		title="Mit der Lightning-Wallet öffnen"
		aria-label={`QR-Code der Lightning-Adresse ${ADDRESS}, anklicken öffnet die Wallet`}
		set:html={qr}
	></a>
	<p class="phalnx-donate-row">
		<a href={`lightning:${ADDRESS}`}><code>{ADDRESS}</code></a>
		<button type="button" data-act="copy" data-address={ADDRESS}>Kopieren</button>
	</p>
	<p class="phalnx-donate-hint">Lightning-Adresse. Scanne den Code mit deiner Lightning-Wallet.</p>
	<p class="phalnx-donate-actions"><button type="button" data-act="close">Schließen</button></p>
</template>

<script>
	let dialog: HTMLDialogElement | null = null;

	function build() {
		const tpl = document.querySelector<HTMLTemplateElement>('.phalnx-donate-tpl');
		if (!tpl) return;
		dialog = document.createElement('dialog');
		dialog.className = 'phalnx-donate-dialog';
		dialog.setAttribute('aria-label', 'Sats spenden');
		dialog.appendChild(tpl.content.cloneNode(true));
		dialog.addEventListener('click', async (e) => {
			const t = e.target as HTMLElement;
			const btn = t.closest('button');
			if (t === dialog || btn?.dataset.act === 'close') dialog!.close();
			if (btn?.dataset.act === 'copy') {
				const old = btn.textContent;
				try {
					await navigator.clipboard.writeText(btn.dataset.address ?? '');
					btn.textContent = 'Kopiert';
				} catch {
					btn.textContent = 'Nicht möglich';
				}
				setTimeout(() => (btn.textContent = old), 1500);
			}
		});
		document.body.appendChild(dialog);
	}

	document.querySelectorAll<HTMLButtonElement>('.phalnx-donate-btn').forEach((b) => {
		b.addEventListener('click', () => {
			if (!dialog) build();
			dialog?.showModal();
		});
	});
</script>

<style>
	.phalnx-build {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
		white-space: nowrap;
		font-variant-numeric: tabular-nums;
	}
	.phalnx-donate-btn {
		display: inline-flex;
		align-items: center;
		padding: 0.25rem;
		border: 0;
		background: none;
		color: var(--sl-color-text-accent);
		cursor: pointer;
	}
	.phalnx-donate-btn:hover {
		color: var(--sl-color-white);
	}
</style>
