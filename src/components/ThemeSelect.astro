---
/**
 * Überschreibt die Theme-Auswahl der Kopfzeile von Starlight.
 * Zeigt zusätzlich den Knopf „Meine Werte" und lädt das Platzhalter-Skript.
 * Starlight rendert diese Komponente in der Kopfzeile und im mobilen Menü.
 */
import Default from '@astrojs/starlight/components/ThemeSelect.astro';
import { PLACEHOLDERS, PLACEHOLDER_GROUPS } from '../config/placeholders';

const config = JSON.stringify({ fields: PLACEHOLDERS, groups: PLACEHOLDER_GROUPS });
---

<phalnx-values data-config={config}>
	<button type="button" class="phalnx-values-btn" aria-haspopup="dialog">
		<svg
			aria-hidden="true"
			width="16"
			height="16"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			<line x1="4" y1="21" x2="4" y2="14"></line>
			<line x1="4" y1="10" x2="4" y2="3"></line>
			<line x1="12" y1="21" x2="12" y2="12"></line>
			<line x1="12" y1="8" x2="12" y2="3"></line>
			<line x1="20" y1="21" x2="20" y2="16"></line>
			<line x1="20" y1="12" x2="20" y2="3"></line>
			<line x1="1" y1="14" x2="7" y2="14"></line>
			<line x1="9" y1="8" x2="15" y2="8"></line>
			<line x1="17" y1="16" x2="23" y2="16"></line>
		</svg>
		<span>Meine Werte</span>
	</button>
</phalnx-values>
<Default {...Astro.props} />

<script>
	import { initPlaceholders } from '../scripts/placeholders';
	import { initDiagramZoom } from '../scripts/diagram-zoom';

	initPlaceholders();
	initDiagramZoom();
</script>
